// Change both identifiers to a unique value before signing.
GOYO_BUNDLE_ID = app.goyo.detox
GOYO_APP_GROUP = group.app.goyo.detox
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
// Set your team in Xcode Signing & Capabilities for all targets.
DEVELOPMENT_TEAM =
CURRENT_PROJECT_VERSION = 4
MARKETING_VERSION = 0.4.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_STRICT_CONCURRENCY = minimal
CLANG_ENABLE_MODULES = YES
SDKROOT = iphoneos
